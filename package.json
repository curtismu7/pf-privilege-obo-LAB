{
  "name": "pf-privilege-obo-LAB",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PingFederate to Privilege OBO delegation lab: interactive chain demo",
  "scripts": {
    "start": "node server/src/index.js",
    "build": "vite build",
    "dev": "vite",
    "test": "npm run test:server && npm run test:web && npm run test:repo",
    "test:server": "node --test --test-reporter=spec test/*.test.js",
    "test:web": "vitest run",
    "test:repo": "node scripts/repo-checks.mjs",
    "doctor": "node scripts/doctor.mjs",
    "reset": "node scripts/reset.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
