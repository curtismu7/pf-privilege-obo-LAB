# Real mode settings for pf-privilege-obo-LAB. Copy to .env (gitignored) and fill in your own tenant's values.
# Mock mode needs none of this. Nothing here is ever shown in the page: tokens are shown as claims and a hash only.

# The person who signs in (a user in your PingFederate).
PFO_USER_NAME=
PFO_USER_PASSWORD=

# PingFederate: the public issuer, and the client used to sign the person in (pi.flow, authorization code + PKCE).
PFO_OBO_ISSUER=https://pf.example
PFO_OBO_SIGNIN_CLIENT=
PFO_OBO_SIGNIN_SECRET=
# How the sign-in client authenticates: basic (default when a secret is set), post, or none (a public client: leave the secret empty).
# PFO_OBO_SIGNIN_AUTH=basic
PFO_OBO_REDIRECT_URI=https://app.example/callback

# The agent's client (it makes the RFC 8693 exchange).
PFO_OBO_AGENT_CLIENT=
PFO_OBO_AGENT_SECRET=

# Agent-side door: a Privilege MCP app in Pass Agent Token mode. TARGET is the exchange parameter your PingFederate
# accepts for this door: audience or resource.
PFO_OBO_AGENT_DOOR=https://gateway.example/your-app/mcp
PFO_OBO_AGENT_TARGET=audience
PFO_OBO_AGENT_SCOPE=mcp opensearch:read

# Gateway OBO door: a Privilege MCP app in Auth Mode OBO. GATEWAY_TOOL is the backend tool that reports the claims it saw.
PFO_OBO_GATEWAY_DOOR=https://gateway.example/your-obo-app/mcp
PFO_OBO_GATEWAY_TARGET=resource
PFO_OBO_GATEWAY_SCOPE=mcp whoami:read
PFO_OBO_GATEWAY_TOOL=whoami

# Run observability (rule 27), Real mode only. Empty by default. A LOOPBACK Elasticsearch origin (a port-forward, for example
# http://127.0.0.1:9200) and a READ-ONLY API key the owner creates. Inside the container loopback is the container itself: use a
# forwarder in the lab's network namespace. Never mount the Docker socket (RUN_OBS_DOCKER=1 is for a throwaway ad-hoc override only).
RUN_OBS_ES_URL=
RUN_OBS_ES_READ_APIKEY=
